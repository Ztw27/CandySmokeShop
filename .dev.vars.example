# Copy to .dev.vars for local testing. In production, set these in
# Cloudflare Pages → Settings → Environment variables (mark LS_TOKEN as a Secret).
# Leave LS_TOKEN empty to run the site in preview mode with sample products.

# Lightspeed Retail (X-Series)
# The part before .retail.lightspeed.app in your Lightspeed URL
LS_DOMAIN_PREFIX=
# Personal access token (Lightspeed → Setup → Personal tokens)
LS_TOKEN=
# Run scripts/lightspeed-ids.mjs to find these four
LS_OUTLET_ID=
LS_REGISTER_ID=
LS_USER_ID=
LS_TAX_ID=

# Comma-separated Lightspeed categories to keep off the website
SHOP_HIDDEN_CATEGORIES=
# Hide items with less stock than this
SHOP_MIN_STOCK=1

# Optional: Slack or Discord webhook URL to ping staff on each new order
ORDER_NOTIFY_WEBHOOK=
